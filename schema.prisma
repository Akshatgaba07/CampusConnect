generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { STUDENT ADMIN }
enum UserStatus { ACTIVE SUSPENDED }
enum OtpPurpose { REGISTER RESET }
enum EventStatus { DRAFT PUBLISHED CANCELLED COMPLETED }
enum SlotMode { OFFLINE ONLINE HYBRID }
enum SeatStatus { AVAILABLE HELD BOOKED }
enum BookingStatus { PENDING CONFIRMED CANCELLED EXPIRED }
enum NotificationStatus { PENDING SENT FAILED }

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  passwordHash  String   @map("password_hash")
  name          String?
  role          Role     @default(STUDENT)
  emailVerified Boolean  @default(false) @map("email_verified")
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  lastLogin     DateTime? @map("last_login")

  sessions      UserSession[]
  bookings      Booking[]
  notifications Notification[]
  auditLogs     AuditLog[]
  events        Event[]       @relation("EventCreator")

  @@map("users")
}

model OtpChallenge {
  id          String     @id @default(uuid()) @db.Uuid
  email       String
  purpose     OtpPurpose @default(REGISTER)
  otpHash     String     @map("otp_hash")
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at")
  consumedAt  DateTime?  @map("consumed_at")
  ip          String?
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model VerifiedRegistrationChallenge {
  id         String     @id @default(uuid()) @db.Uuid
  email      String
  purpose    OtpPurpose @default(REGISTER)
  tokenHash  String     @unique @map("token_hash")
  expiresAt  DateTime   @map("expires_at")
  usedAt     DateTime?  @map("used_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([email])
  @@map("verified_registration_challenges")
}

model UserSession {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @unique @map("refresh_token_hash")
  userAgent        String?  @map("user_agent")
  ip               String?
  expiresAt        DateTime @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model Event {
  id                String      @id @default(uuid()) @db.Uuid
  title             String
  description       String
  category          String
  venue             String
  posterUrl         String?     @map("poster_url")
  speaker           String?
  organizer         String
  status            EventStatus @default(DRAFT)
  registrationOpens  DateTime   @map("registration_opens")
  registrationCloses DateTime   @map("registration_closes")
  createdBy         String?     @map("created_by") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  creator User?       @relation("EventCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  slots   EventSlot[]

  @@index([status, registrationOpens])
  @@index([category])
  @@map("events")
}

model EventSlot {
  id             String   @id @default(uuid()) @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  startsAt       DateTime @map("starts_at")
  endsAt         DateTime @map("ends_at")
  capacity       Int
  confirmedCount Int      @default(0) @map("confirmed_count")
  mode           SlotMode @default(OFFLINE)
  maxSeatsPerBooking Int  @default(2) @map("max_seats_per_booking")

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seats    Seat[]
  bookings Booking[]

  @@index([eventId, startsAt])
  @@map("event_slots")
}

model Seat {
  id      String     @id @default(uuid()) @db.Uuid
  slotId  String     @map("slot_id") @db.Uuid
  label   String
  status  SeatStatus @default(AVAILABLE)
  version Int        @default(0)

  slot         EventSlot     @relation(fields: [slotId], references: [id], onDelete: Cascade)
  bookingSeats BookingSeat[]

  @@unique([slotId, label])
  @@index([slotId, status])
  @@map("seats")
}

model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  slotId         String        @map("slot_id") @db.Uuid
  status         BookingStatus @default(PENDING)
  quantity       Int
  holdExpiresAt  DateTime?     @map("hold_expires_at")
  idempotencyKey String        @map("idempotency_key")
  createdAt      DateTime      @default(now()) @map("created_at")
  confirmedAt    DateTime?     @map("confirmed_at")
  cancelledAt    DateTime?     @map("cancelled_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot     EventSlot     @relation(fields: [slotId], references: [id], onDelete: Restrict)
  seats    BookingSeat[]
  tickets  Ticket[]

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
  @@index([slotId, status])
  @@index([status, holdExpiresAt])
  @@map("bookings")
}

model BookingSeat {
  id        String @id @default(uuid()) @db.Uuid
  bookingId String @map("booking_id") @db.Uuid
  seatId    String @map("seat_id") @db.Uuid

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat    Seat    @relation(fields: [seatId], references: [id], onDelete: Restrict)
  ticket  Ticket?

  @@unique([bookingId, seatId])
  @@index([seatId])
  @@map("booking_seats")
}

model Ticket {
  id            String    @id @default(uuid()) @db.Uuid
  bookingId     String    @map("booking_id") @db.Uuid
  bookingSeatId String    @unique @map("booking_seat_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  issuedAt      DateTime  @default(now()) @map("issued_at")
  checkedInAt   DateTime? @map("checked_in_at")
  checkedInBy   String?   @map("checked_in_by")

  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingSeat BookingSeat @relation(fields: [bookingSeatId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("tickets")
}

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  type      String
  channel   String             @default("EMAIL")
  payload   Json
  status    NotificationStatus @default(PENDING)
  error     String?
  sentAt    DateTime?          @map("sent_at")
  createdAt DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  topic       String
  key         String
  payload     Json
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}
